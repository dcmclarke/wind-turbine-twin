# Copy to .env for running the backend outside Docker.
# Docker Compose sets these itself.

# Defaults to a local SQLite file when unset
DATABASE_URL=postgresql://postgres:password@localhost:5432/windturbine

# Where readings come from: demo (replay bundled data in-process), mqtt, or none
INGEST_MODE=demo

# Demo feed: wall-clock seconds between 10-minute readings (2 s = 300x real time)
DEMO_SECONDS_PER_SAMPLE=2
# Readings before this are preloaded instantly each loop; the rest stream live
DEMO_LIVE_FROM=2022-11-04T00:00:00

# MQTT feed
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=windfarm/av7/scada/10min

# Allow POST /api/readings (off by default so the public demo can't be fed fake data)
ALLOW_HTTP_INGEST=false

# Deployed frontend origin, for CORS
FRONTEND_URL=
